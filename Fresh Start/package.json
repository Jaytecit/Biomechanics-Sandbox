    "smoke:evolve": "tsx scripts/smoke-evolve-run.mts",
    "smoke:evolve-ui": "tsx scripts/smoke-evolve-responsive.mts",
    "smoke:live": "tsx scripts/smoke-live-batch.mts",
    "smoke:tasks": "tsx scripts/smoke-tasks.mts",
    "smoke:all": "npm run smoke:firewall && npm run smoke:feel && npm run smoke:evolve && npm run smoke:tasks"
