  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.23.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
